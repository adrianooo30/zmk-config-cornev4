/*
 * Corne (wireless) ZMK keymap - converted from QMK crkbd keymap.c
 * Layers: 0 BASE | 1 NUM/MEDIA | 2 SYM/NAV | 3 ADJUST (RGB, F-keys, Bluetooth)
 * Layer 3 activates automatically when 1 + 2 are held (QMK update_tri_layer_state).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE   0
#define NUM    1
#define SYM    2
#define ADJUST 3

/* QMK TAPPING_TERM 200 + PERMISSIVE_HOLD  ->  "balanced" flavor */
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUM SYM>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp CAPS  &kp Q  &kp W  &kp E     &kp R      &kp T          &kp Y      &kp U       &kp I      &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S  &kp D     &kp F      &kp G          &kp H      &kp J       &kp K      &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C     &kp V      &kp B          &kp N      &kp M       &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                        &kp LGUI  &kp LCTRL  &lt NUM SPACE  &kp RET    &lt SYM SPACE  &kp RALT
            >;
        };

        num_layer {
            bindings = <
&kp ESC   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5            &kp PAUSE_BREAK  &kp C_PLAY_PAUSE  &kp LBRC   &kp RBRC  &trans &trans
&kp ESC   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0            &kp C_MUTE       &kp C_VOL_DN      &kp C_VOL_UP &kp C_PREV &trans &trans
&mo SYM   &trans  &trans  &trans  &trans  &kp LG(LS(N4))    &kp K_POWER      &none             &kp LBRC   &kp RBRC  &trans &trans
                          &trans  &trans  &kp SPACE         &mo SYM          &trans            &kp RALT
            >;
        };

        sym_layer {
            bindings = <
&kp TAB   &kp EXCL &kp AT  &kp HASH &kp DLLR &kp PRCNT      &kp CARET &kp AMPS  &kp STAR &kp LPAR &kp RPAR &kp DEL
&kp CAPS  &trans   &trans  &trans   &kp HOME &kp PG_UP      &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &kp BSLH &lt NUM SPACE
&kp LSHFT &trans   &trans  &trans   &kp END  &kp PG_DN      &trans    &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp GRAVE
                           &trans   &trans   &kp ESC        &kp RET   &kp SPACE &kp RALT
            >;
        };

        adjust_layer {
            bindings = <
&bootloader &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &none
&trans  &rgb_ug RGB_SAI &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_TOG &rgb_ug RGB_SPI   &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &none
&trans  &rgb_ug RGB_SAD &rgb_ug RGB_EFR &rgb_ug RGB_BRD &rgb_ug RGB_EFF &rgb_ug RGB_SPD   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                            &kp LGUI &trans &kp SPACE       &kp RET  &trans   &out OUT_TOG
            >;
        };
    };
};
